[Unit]
Description=llama.cpp agent stack (Qwen3.6-35B-A3B workers on 5000, Qwen3.6-27B planner/judge on 5001)
After=network.target

[Service]
Type=simple
User=tanker
WorkingDirectory=/home/tanker/projects/work/homelab-llm
ExecStart=/home/tanker/projects/work/homelab-llm/scripts/start-agent-stack.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
